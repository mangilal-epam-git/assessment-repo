# Copy to .env for local runs: cp .env.example .env
# Never commit a real .env. Secrets come from AWS Secrets Manager or Azure
# Key Vault in deployed environments (see docs/architecture/security.md).

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Pricing configuration snapshot
PRICING_CONFIG_PATH=config/pricing-config.json
CONFIG_WATCH_ENABLED=true

# Provider endpoints. Identity is derived from these, never from payload fields.
PROVIDER_TELEMETRY1_URL=http://127.0.0.1:8081/provider/telemetry1
PROVIDER_TELEMETRY2_URL=http://127.0.0.1:8081/provider/telemetry2

# Resilience
PROVIDER_TIMEOUT_MS=2000
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_INITIAL_DELAY_MS=100
PROVIDER_RETRY_MAX_DELAY_MS=1000
PROVIDER_RETRY_BUDGET_MS=5000
PROVIDER_MAX_BODY_BYTES=8388608
REQUEST_TIMEOUT_MS=10000
MAX_CONCURRENT_REQUESTS=256
SHUTDOWN_GRACE_MS=15000

# Protects POST /admin/config/reload. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-locally

# Pin the clock for reproducible fixture output. Leave empty in production.
FIXED_CLOCK=2026-06-15T10:05:00Z
