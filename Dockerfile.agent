# syntax=docker/dockerfile:1.7
#
# Supervised fleet assistant. Same hardening as the best-offers image:
# non-root, read-only root filesystem, no build tooling, tini for signals.

FROM node:22.12.0-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    AGENT_PORT=8082 \
    AGENT_HOST=0.0.0.0 \
    LOG_LEVEL=info \
    MODEL_BACKEND=deterministic

RUN apk add --no-cache tini=~0.19

COPY --chown=node:node package.json ./
COPY --chown=node:node src/agent ./src/agent
COPY --chown=node:node src/best-offers ./src/best-offers

USER node
EXPOSE 8082

ENTRYPOINT ["/sbin/tini", "--"]

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.AGENT_PORT||8082)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/agent/server.js"]
