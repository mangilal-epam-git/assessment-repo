# syntax=docker/dockerfile:1.7
#
# Mock telemetry providers. These stand in for the two external data sources
# that VectorHarbor would otherwise consume; see docs/architecture/boundaries.md
# for what is mocked and why.

FROM node:22.12.0-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    MOCK_PORT=8081 \
    MOCK_HOST=0.0.0.0 \
    FIXTURE_DIR=/app/fixtures

RUN apk add --no-cache tini=~0.19

COPY --chown=node:node package.json ./
COPY --chown=node:node src/mock-providers ./src/mock-providers
COPY --chown=node:node fixtures ./fixtures

USER node
EXPOSE 8081

ENTRYPOINT ["/sbin/tini", "--"]

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.MOCK_PORT||8081)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/mock-providers/server.js"]
