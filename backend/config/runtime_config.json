from __future__ import annotations

from fastapi.testclient import TestClient

from app.main import app

client = TestClient(app)


def test_best_offers_endpoint() -> None:
    response = client.get("/best-offers")
    assert response.status_code == 200
    payload = response.json()

    assert payload["currency"] == "EUR"
    assert payload["partial"] is True
    assert isinstance(payload["offers"], list)
    assert payload["offers"]
    assert [offer["productId"] for offer in payload["offers"]] == sorted([offer["productId"] for offer in payload["offers"]])
    assert len(payload["offers"]) == 5

    braking_offer = next(item for item in payload["offers"] if item["productId"] == "eu-west-braking-hour")
    assert braking_offer["providerId"] == "telemetry2"
    assert braking_offer["qualityRatio"] == "0.9600"


def test_provider_ingest_and_runtime_reload() -> None:
    response = client.get("/provider/telemetry1")
    assert response.status_code == 200
    payload = response.json()
    assert isinstance(payload, list)
    assert payload[0]["productId"] == "eu-north-location-hour"

    bad_reload = client.post("/config/reload", json={"defaultMarginBasisPoints": "bad"})
    assert bad_reload.status_code == 200
    assert bad_reload.json()["status"] == "config_reloaded"

    valid_reload = client.post(
        "/config/reload",
        json={
            "fxVersion": "fx-demo-2",
            "fxRates": {"EUR": "1.00", "USD": "0.92", "GBP": "1.18"},
            "marginVersion": "margin-demo-2",
            "defaultMarginBasisPoints": 1500,
            "minimumQualityRatio": "0.92",
        },
    )
    assert valid_reload.status_code == 200
    assert valid_reload.json()["snapshot"]["marginVersion"] == "margin-demo-2"


def test_access_policy_endpoint() -> None:
    response = client.post(
        "/users",
        json={
            "userId": "user-ref-42",
            "team": "fleet-ops",
            "dataDomains": ["telematics", "diagnostics"],
            "blockedPaymentTypes": ["bitcoin"],
        },
    )
    assert response.status_code == 200
    payload = response.json()
    assert payload["userId"] == "user-ref-42"

    check = client.get("/access/check?userId=user-ref-42&team=fleet-ops&dataDomain=telematics&paymentType=bitcoin")
    assert check.status_code == 200
    assert check.json()["allowed"] is False
