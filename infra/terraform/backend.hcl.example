# AzureRM remote backend settings for a state account/container bootstrapped separately.
# Copy this file to backend.hcl and fill in the approved values; do not commit it.
resource_group_name  = "REPLACE_WITH_STATE_RESOURCE_GROUP"
storage_account_name = "REPLACE_WITH_STATE_STORAGE_ACCOUNT"
container_name       = "tfstate"
key                  = "vectorharbor/dev/eu-north/terraform.tfstate"
use_azuread_auth     = true
