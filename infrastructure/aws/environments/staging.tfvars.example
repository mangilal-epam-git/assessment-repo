# Staging: production-shaped, smaller. Launch gates are measured here.

environment = "staging"
aws_region  = "eu-north-1"

vpc_cidr                = "10.41.0.0/16"
availability_zone_count = 3
single_nat_gateway      = false

service_cpu           = 512
service_memory        = 1024
service_desired_count = 2
service_min_capacity  = 2
service_max_capacity  = 20

# Requests per target per MINUTE; 12000/min = 200 rps per task.
target_requests_per_task = 12000

deploy_mock_providers = true
log_level             = "info"
log_retention_days    = 30

enable_deletion_protection = true

# Replace with the ACM certificate ARN for the staging hostname.
certificate_arn = "arn:aws:acm:eu-north-1:000000000000:certificate/REPLACE-ME"

allowed_ingress_cidrs   = ["0.0.0.0/0"]
waf_rate_limit_per_5min = 20000

alarm_email_subscriptions = ["platform-oncall@vectorharbor.example"]
