# Remote state for the prod environment.
#   terraform init -backend-config=environments/prod.backend.hcl
#
# Create the storage account and container once per subscription before the
# first init; see infrastructure/README.md for the bootstrap commands.

resource_group_name  = "rg-vectorharbor-tfstate"
storage_account_name = "stvhtfstateREPLACEME"
container_name       = "tfstate"
key                  = "best-offers/prod/terraform.tfstate"
use_azuread_auth     = true
