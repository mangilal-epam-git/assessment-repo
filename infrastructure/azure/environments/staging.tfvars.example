# Staging on Azure: production-shaped, smaller. Launch gates are measured here.

environment = "staging"
location    = "swedencentral"

vnet_cidr = "10.51.0.0/16"

service_cpu    = 0.5
service_memory = "1Gi"
min_replicas   = 2
max_replicas   = 20

concurrent_requests_per_replica = 100

deploy_mock_providers = true
log_level             = "info"
log_retention_days    = 30

enable_front_door         = true
waf_mode                  = "Detection" # tune the rules here before enforcing
waf_rate_limit_per_minute = 4000

alarm_email_subscriptions = ["platform-oncall@vectorharbor.example"]

# Fleet assistant on Azure OpenAI, keeping inference inside the tenancy.
deploy_agent         = true
agent_model_backend  = "azure-openai"
agent_model_name     = "gpt4o-eu" # the DEPLOYMENT name, not the model name
agent_model_base_url = "https://REPLACE-ME.openai.azure.com"
agent_min_replicas   = 2
agent_max_replicas   = 6

# Set the key out of band after apply:
#   az keyvault secret set --vault-name <key_vault_name> --name model-api-key --value '...'
