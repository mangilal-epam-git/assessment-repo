{
  "name": "vectorharbor-best-offers",
  "version": "1.0.0",
  "description": "VectorHarbor Mobility - provider-offer normalisation and ranking service (quality-normalised best eligible offer per canonical telemetry product).",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/best-offers/server.js",
    "start:mock": "node src/mock-providers/server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "check": "node scripts/check.js && node scripts/check-terraform.js && node scripts/check-docs.js",
    "smoke": "node scripts/smoke.js",
    "check:tf": "node scripts/check-terraform.js",
    "check:docs": "node scripts/check-docs.js",
    "agent": "node src/agent/server.js",
    "start:agent": "node src/agent/server.js",
    "test:report": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info \"test/**/*.test.js\"",
    "security": "npm run security:deps && npm run security:code && npm run security:iac",
    "security:deps": "snyk test --severity-threshold=high",
    "security:code": "snyk code test --severity-threshold=high",
    "security:iac": "snyk iac test infrastructure --severity-threshold=high",
    "security:container": "snyk container test vectorharbor/best-offers:local --file=Dockerfile --severity-threshold=high --fail-on=upgradable",
    "security:monitor": "snyk monitor --all-projects --project-name=vectorharbor-best-offers",
    "security:report": "node -e \"require('node:fs').mkdirSync('reports',{recursive:true})\" && snyk code test --sarif-file-output=reports/snyk-code.sarif || true"
  }
}
